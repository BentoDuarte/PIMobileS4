<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainer"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Perfil"
            android:textAppearance="@style/TextoTela.Titulo"
            android:accessibilityHeading="true" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/fundo_painel"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/perfil_sessao"
                android:textAppearance="@style/TextoTela.Apoio" />
            <TextView
                android:id="@+id/emailPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextoTela.Secao" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/acessibilidadePerfil"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/tamanhoAlvoToque"
            android:text="@string/perfil_configuracoes"
            app:icon="@drawable/ic_configuracoes"
            app:iconGravity="textStart" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sairPerfil"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/tamanhoAlvoToque"
            android:text="Sair da conta"
            app:icon="@drawable/ic_sair"
            app:iconGravity="textStart" />
    </LinearLayout>
</ScrollView>
