<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/tamanho_texto"
            android:textAppearance="@style/TextoTela.Secao" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tamanho_texto_ajuda"
            android:textAppearance="@style/TextoTela.Apoio" />

        <RadioGroup
            android:id="@+id/tamanhosTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/textoPadrao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/tamanhoAlvoToque"
                android:text="@string/texto_padrao" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/textoMais10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/tamanhoAlvoToque"
                android:text="@string/texto_mais_10" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/textoMais20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/tamanhoAlvoToque"
                android:text="@string/texto_mais_20" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/textoMais40"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/tamanhoAlvoToque"
                android:text="@string/texto_mais_40" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityHeading="true"
            android:text="@string/ajustes_visuais"
            android:textAppearance="@style/TextoTela.Secao" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/preferenciaTemaEscuro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/tamanhoAlvoToque"
            android:text="@string/tema_escuro" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/preferenciaAltoContraste"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/tamanhoAlvoToque"
            android:text="@string/alto_contraste" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/preferenciaBotoesMaiores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/tamanhoAlvoToque"
            android:text="@string/botoes_maiores" />
    </LinearLayout>
</ScrollView>
