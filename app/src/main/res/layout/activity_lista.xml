<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp" android:background="@color/surface">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ordens de serviço" android:textSize="28sp" android:textColor="@color/ink" android:layout_marginBottom="12dp"/><EditText android:id="@+id/busca" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:hint="Buscar por número, título ou cliente" android:inputType="text" android:padding="12dp" android:layout_marginBottom="12dp" /><Spinner android:id="@+id/filtro" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="12dp"/><com.google.android.material.button.MaterialButton android:id="@+id/nova" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Criar ordem" android:layout_marginTop="8dp"/>
<TextView android:id="@+id/contador" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp"/>
<ListView android:id="@+id/lista" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:dividerHeight="8dp"/><com.google.android.material.button.MaterialButton android:id="@+id/sair" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Sair" android:layout_marginTop="8dp"/>
</LinearLayout>