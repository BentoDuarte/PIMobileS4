<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/colorSurface" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">
<TextView android:layout_width="match_parent"
    android:layout_height="wrap_content" android:text="Detalhes da ordem"
    android:textSize="28sp" android:textStyle="bold" android:accessibilityHeading="true" android:textColor="?attr/colorOnSurface"
    android:layout_marginBottom="12dp"/>
<TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textSize="22sp"
    android:textStyle="bold"
    android:textColor="?attr/colorOnSurface"
    android:layout_marginBottom="12dp"
    android:id="@+id/tituloDetalhe"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:lineSpacingExtra="4dp"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="12dp"
        android:id="@+id/dados"/>
    <com.google.android.material.button.MaterialButton
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:id="@+id/recarregarDetalhes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tentar novamente"
        android:visibility="gone" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/editar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp" android:text="Editar ordem"
        android:layout_marginTop="8dp" app:icon="@drawable/ic_editar" app:iconGravity="textStart" app:iconSize="18dp" />
    <com.google.android.material.button.MaterialButton
        style="@style/Widget.Material3.Button.OutlinedButton" android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="Alterar status"
        android:layout_marginTop="8dp" app:icon="@drawable/ic_status" app:iconGravity="textStart" app:iconSize="18dp" />
    <com.google.android.material.button.MaterialButton
        style="@style/Widget.Material3.Button.OutlinedButton" android:id="@+id/pdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="Gerar PDF"
        android:layout_marginTop="8dp" app:icon="@drawable/ic_documento" app:iconGravity="textStart" app:iconSize="18dp" />
    <com.google.android.material.button.MaterialButton
        style="@style/Widget.Material3.Button.OutlinedButton" android:textColor="?attr/colorError" android:id="@+id/excluir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="Excluir ordem"
        android:layout_marginTop="8dp" app:icon="@drawable/ic_excluir" app:iconGravity="textStart" app:iconSize="18dp" app:iconTint="?attr/colorError" />
    <com.google.android.material.button.MaterialButton
        style="@style/Widget.Material3.Button.OutlinedButton" android:id="@+id/voltar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
    android:text="Voltar para a lista" android:layout_marginTop="8dp" app:icon="@drawable/ic_voltar" app:iconGravity="textStart" app:iconSize="18dp" />
</LinearLayout>
</ScrollView>
