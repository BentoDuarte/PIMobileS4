<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/colorSurfaceContainer" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">
<TextView android:layout_width="match_parent"
    android:layout_height="wrap_content" android:text="Detalhes da ordem"
    android:accessibilityHeading="true" android:textAppearance="@style/TextoTela.Titulo"
    android:layout_marginBottom="12dp"/>
    <TextView
        android:id="@+id/dados"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="@style/TextoTela.Apoio" />
    <LinearLayout
        android:id="@+id/painelDetalhes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/fundo_painel"
        android:orientation="vertical"
        android:padding="18dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tituloDetalhe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:textAppearance="@style/TextoTela.Secao" />

        <TextView
            android:id="@+id/situacaoDetalhe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/fundo_resumo"
            android:padding="12dp"
            android:textAppearance="@style/TextoTela.Apoio"
            android:textColor="?attr/colorOnPrimaryContainer" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityHeading="true"
            android:text="@string/ordem_secao_cliente"
            android:textAppearance="@style/TextoTela.Secao" />

        <TextView
            android:id="@+id/clienteDetalhe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="4dp"
            android:textAppearance="@style/TextoTela.Apoio" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityHeading="true"
            android:text="@string/ordem_secao_atendimento"
            android:textAppearance="@style/TextoTela.Secao" />

        <TextView
            android:id="@+id/atendimentoDetalhe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="4dp"
            android:textAppearance="@style/TextoTela.Apoio" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:id="@+id/recarregarDetalhes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tentar novamente"
        android:visibility="gone" />
    <TextView
        android:id="@+id/tituloAcoesDetalhe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="@string/ordem_secao_acoes"
        android:textAppearance="@style/TextoTela.Secao"
        android:visibility="gone" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/editar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp" android:text="Editar ordem"
        android:layout_marginTop="8dp" app:icon="@drawable/ic_editar" app:iconGravity="textStart" app:iconSize="18dp" />
    <com.google.android.material.button.MaterialButton
        style="@style/Widget.Material3.Button.OutlinedButton" android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="Alterar status"
        android:layout_marginTop="8dp" app:icon="@drawable/ic_status" app:iconGravity="textStart" app:iconSize="18dp" />
    <com.google.android.material.button.MaterialButton
        style="@style/Widget.Material3.Button.OutlinedButton" android:id="@+id/pdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="Gerar PDF"
        android:layout_marginTop="8dp" app:icon="@drawable/ic_documento" app:iconGravity="textStart" app:iconSize="18dp" />
    <com.google.android.material.button.MaterialButton
        style="@style/Widget.Material3.Button.OutlinedButton" android:textColor="?attr/colorError" android:id="@+id/excluir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="Excluir ordem"
        android:layout_marginTop="8dp" app:icon="@drawable/ic_excluir" app:iconGravity="textStart" app:iconSize="18dp" app:iconTint="?attr/colorError" />
    <com.google.android.material.button.MaterialButton
        style="@style/Widget.Material3.Button.TextButton" android:id="@+id/voltar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
    android:text="Voltar para a lista" android:layout_marginTop="8dp" app:icon="@drawable/ic_voltar" app:iconGravity="textStart" app:iconSize="18dp" />
</LinearLayout>
</ScrollView>
