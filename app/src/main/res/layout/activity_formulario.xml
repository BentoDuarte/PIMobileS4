<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/colorSurfaceContainer" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nova_ordem" android:textAppearance="@style/TextoTela.Titulo" android:accessibilityHeading="true" android:layout_marginBottom="4dp" android:id="@+id/cabecalho"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Informe os dados do serviço. Os campos com * são obrigatórios." android:textAppearance="@style/TextoTela.Apoio" android:layout_marginBottom="16dp"/>
<com.google.android.material.button.MaterialButton
    android:id="@+id/tirarFotoPedido"
    style="@style/Widget.Material3.Button.OutlinedButton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:minHeight="?attr/tamanhoAlvoToque"
    android:text="@string/tirar_foto_pedido"
    android:visibility="gone" />
<com.google.android.material.button.MaterialButton
    android:id="@+id/importarFotoPedido"
    style="@style/Widget.Material3.Button.OutlinedButton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:minHeight="?attr/tamanhoAlvoToque"
    android:text="@string/importar_foto"
    android:visibility="gone" />
<TextView
    android:id="@+id/revisarRascunho"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:accessibilityLiveRegion="polite"
    android:text="@string/revisar_rascunho"
    android:textAppearance="@style/TextoTela.Apoio"
    android:visibility="gone" />
<TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:accessibilityHeading="true"
    android:text="@string/ordem_secao_servico"
    android:textAppearance="@style/TextoTela.Secao" />
<com.google.android.material.textfield.TextInputLayout
    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:hint="Título *">
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/titulo" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences"  />
</com.google.android.material.textfield.TextInputLayout>
<TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:accessibilityHeading="true"
    android:text="@string/ordem_secao_cliente"
    android:textAppearance="@style/TextoTela.Secao" />
<com.google.android.material.textfield.TextInputLayout
    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:hint="Nome do cliente *">
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/cliente" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences"  />
</com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout
    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:hint="Telefone">
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/telefone" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone"  />
</com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout
    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:hint="E-mail do cliente">
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/emailCliente" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress"  />
</com.google.android.material.textfield.TextInputLayout>
<TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:accessibilityHeading="true"
    android:text="@string/ordem_secao_atendimento"
    android:textAppearance="@style/TextoTela.Secao" />
<com.google.android.material.textfield.TextInputLayout
    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:hint="Descrição do serviço *">
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/descricao" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine|textCapSentences" android:minLines="4" android:gravity="top" />
</com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout
    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:hint="Responsável">
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/responsavel" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences"  />
</com.google.android.material.textfield.TextInputLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@id/prioridade" android:text="Prioridade" android:textSize="16sp" android:textColor="?attr/colorOnSurface" android:layout_marginBottom="12dp"/>
<Spinner android:id="@+id/prioridade" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginBottom="12dp"/>
<com.google.android.material.button.MaterialButton
    android:id="@+id/buscarOrdensParecidas"
    style="@style/Widget.Material3.Button.OutlinedButton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="?attr/tamanhoAlvoToque"
    android:text="@string/buscar_ordens_parecidas"
    android:visibility="gone" />
<com.google.android.material.button.MaterialButton android:id="@+id/salvar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="?attr/tamanhoAlvoToque" android:text="Salvar ordem" android:layout_marginTop="8dp" app:icon="@drawable/ic_salvar" app:iconGravity="textStart" app:iconSize="18dp" />
<com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.OutlinedButton" android:id="@+id/cancelar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="?attr/tamanhoAlvoToque" android:text="Cancelar" android:layout_marginTop="8dp" app:icon="@drawable/ic_voltar" app:iconGravity="textStart" app:iconSize="18dp" />
</LinearLayout>
</ScrollView>
