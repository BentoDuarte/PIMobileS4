<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainer"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Relatórios"
            android:textColor="?attr/colorOnSurface"
            android:textSize="28sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Escolha um status para gerar um PDF com a quantidade de ordens correspondente."
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/filtroRelatorio"
            android:text="Status do relatório" />
        <Spinner
            android:id="@+id/filtroRelatorio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />
        <TextView
            android:id="@+id/resumoRelatorio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Carregando contagem…"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/gerarRelatorio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Gerar PDF"
            app:icon="@drawable/ic_documento"
            app:iconGravity="textStart" />
    </LinearLayout>
</ScrollView>
