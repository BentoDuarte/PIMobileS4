rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid} {
      function dono() {
        return request.auth != null && request.auth.uid == uid;
      }
      match /ordens/{id} {
        allow read, create, update, delete: if dono();
      }
      match /config/sequencia {
        allow read, create, update: if dono();
      }
      match /registros/{id} {
        allow read: if dono();
        allow create: if dono()
          && request.resource.data.keys().hasOnly(['ordemId', 'titulo', 'acao', 'status', 'data'])
          && request.resource.data.ordemId is int
          && request.resource.data.ordemId > 0
          && request.resource.data.titulo is string
          && request.resource.data.acao in ['CRIACAO', 'EDICAO', 'ALTERACAO_STATUS', 'EXCLUSAO']
          && request.resource.data.status in ['ABERTA', 'EM_ANDAMENTO', 'CONCLUIDA', 'CANCELADA']
          && request.resource.data.data == request.time;
      }
    }
  }
}
